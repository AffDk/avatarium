# ── App ─────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-generate-with-python-c-import-secrets-print-secrets-token-hex-32
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database ────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./avatarium.db

# ── fal.ai ──────────────────────────────────────
FAL_KEY=your-fal-api-key-here

# ── Gemini ──────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Google OAuth (optional) ─────────────────────
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── JWT ─────────────────────────────────────────
JWT_SECRET_KEY=change-me-generate-with-python-c-import-secrets-print-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ── SMTP ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
APP_BASE_URL=http://localhost:8000